# ==============================================================================
# STREAMSPORT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# Server Network Settings
STREAMSPORT_HOST=0.0.0.0
STREAMSPORT_PORT=7002
# PUBLIC_URL=https://streamsport.yourdomain.com
# STREAMSPORT_DEBUG=false

# ------------------------------------------------------------------------------
# Upstream Providers & Integrations
# ------------------------------------------------------------------------------

# Streamed API (Attualmente defunto/offline upstream - impostare su false)
ENABLE_STREAMED=false
STREAMED_API_HOST=streamed.pk

# Orange Cat Blacktop Motorsport Registry (Opzionale, precisione sessioni motori)
ENABLE_OCBLACKTOP=false
OCBLACKTOP_API_KEY=your_ocblacktop_api_key_here
OCBLACKTOP_API_BASE=https://api.ocblacktop.com/v1

# TheSportsDB (Opzionale, locandine 16:9 e calendario ufficiale)
ENABLE_THESPORTSDB=true
THESPORTSDB_USER=your_username_here
THESPORTSDB_PASS=your_password_here
THESPORTSDB_API_KEY=123
THESPORTSDB_CALENDAR_INTERVAL=43200

# Provider Live e Replay
ENABLE_TVVOO=true
ENABLE_ITALIAN_EPG=true
ENABLE_MANDRAKODI=true
ENABLE_FCTV33=true
ENABLE_SPON=true
ENABLE_REPLAYS=false
