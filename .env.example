# Orange Cat Blacktop Motorsport API Key (Optional)
OCBLACKTOP_API_KEY=your_ocblacktop_api_key_here

# Enable/Disable post-match replays & highlights (true/false)
ENABLE_REPLAYS=false

# TheSportsDB Credentials (Optional, for calendar poster enrichment)
THESPORTSDB_USER=your_username_here
THESPORTSDB_PASS=your_password_here

# StreamSport Server
# STREAMSPORT_HOST=0.0.0.0
# STREAMSPORT_PORT=7002
# PUBLIC_URL=https://streamsport.yourdomain.com
